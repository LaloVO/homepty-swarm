{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "validating",
        "blocked",
        "queued",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "expired",
        "cancelled_with_orphan_check_pending"
      ]
    },
    "lastCursor": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "runId",
    "attempt",
    "status",
    "lastCursor"
  ],
  "additionalProperties": false
}
